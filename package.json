{
  "name": "constellation",
  "version": "3.5.2",
  "private": true,
  "bin": {
    "constellation": "src/cli.mjs"
  },
  "type": "module",
  "description": "Turn developer and project data into interactive constellations, embeds and README graphics.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:core": "node scripts/build-core.mjs",
    "build:rust": "node scripts/build-rust.mjs",
    "test:rust": "cargo test --locked --manifest-path rust/constellation-core/Cargo.toml",
    "generate": "node src/cli.mjs",
    "test": "node --test --test-concurrency=1",
    "preview": "node scripts/serve.mjs",
    "generate:profile": "node scripts/generate-profile.mjs"
  }
}
