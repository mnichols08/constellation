{
  "name": "constellation",
  "version": "2.6.0",
  "private": true,
  "bin": { "constellation": "src/cli.mjs" },
  "type": "module",
  "description": "Your public GitHub projects, connected in an animated README constellation.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:core": "node scripts/build-core.mjs",
    "build:rust": "node scripts/build-rust.mjs",
    "test:rust": "cargo test --locked --manifest-path rust/constellation-core/Cargo.toml",
    "generate": "node src/cli.mjs",
    "test": "node --test",
    "preview": "node scripts/serve.mjs",
    "generate:profile": "node scripts/generate-profile.mjs"
  }
}
